MCP_PRISM_HOST=127.0.0.1
MCP_PRISM_PORT=8787
MCP_PRISM_REQUIRE_CLIENT_KEY=false
MCP_PRISM_TRUST_STDIO_TRANSPORT=true
MCP_PRISM_HMAC_SECRET=change-me-in-production
MCP_PRISM_ENCRYPTION_KEY=change-me-in-production
MCP_PRISM_LOG_FORMAT=pretty
MCP_PRISM_ENABLE_METRICS=true
MCP_PRISM_SSE_KEEPALIVE_SECONDS=15
MCP_PRISM_CACHE_TTL_SECONDS=60
MCP_PRISM_CACHE_TTL_REALTIME_SECONDS=300
MCP_PRISM_CACHE_TTL_DAILY_SECONDS=3600
MCP_PRISM_CACHE_TTL_MONTHLY_SECONDS=86400
MCP_PRISM_CACHE_TTL_YEARLY_SECONDS=2592000
MCP_PRISM_CACHE_PREFIX=mcp-prism
MCP_PRISM_CLIENT_RPM=120
MCP_PRISM_PROVIDER_DEFAULT_RPM=60
REDIS_URL=redis://127.0.0.1:6379

# Proxy: system | direct | custom
MCP_PRISM_PROXY_MODE=system
# MCP_PRISM_HTTP_PROXY=http://127.0.0.1:52380
# MCP_PRISM_HTTPS_PROXY=http://127.0.0.1:52380
# MCP_PRISM_ALL_PROXY=socks5://127.0.0.1:1080
# MCP_PRISM_NO_PROXY=127.0.0.1,localhost,.internal

# Optional small-model routing line (OpenAI-compatible endpoint)
MCP_PRISM_ROUTER_ENABLE_LLM=false
MCP_PRISM_ROUTER_BASE_URL=https://api.openai.com/v1
MCP_PRISM_ROUTER_ENDPOINT=/chat/completions
MCP_PRISM_ROUTER_MODEL=gpt-4o-mini
MCP_PRISM_ROUTER_API_KEY=
# MCP_PRISM_ROUTER_EXPERIMENTS=[{"name":"gov-canary","search_types":["government"],"variants":[{"name":"stable","weight":90,"primary_sources":["datagov","openfda"],"secondary_sources":["census"],"strategy":"parallel"},{"name":"canary","weight":10,"primary_sources":["openfda","census"],"secondary_sources":["datagov"],"strategy":"parallel"}]}]

# Provider keys: only fill the ones you actually have.
BRAVE_API_KEY=
TAVILY_API_KEY=
ZHIPU_API_KEY=
METASO_API_KEY=
METASO_BASE_URL=https://metaso.cn
OPENALEX_EMAIL=
NCBI_API_KEY=
AMAP_API_KEY=
FINANCE_MCP_URL=
FINANCE_MCP_TOKEN=
GITHUB_TOKEN=
DATAGOV_API_KEY=
OPENFDA_API_KEY=
